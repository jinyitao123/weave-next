# Platform startup: copy this file to .env at the repository root.
# Generate separate values with: openssl rand -hex 32
WEAVE_VERSION=0.1.0-dev
NPM_REGISTRY=https://registry.npmjs.org
# Optional proxy reachable from inside Docker, for example http://host.docker.internal:7890.
DOCKER_BUILD_HTTP_PROXY=
DOCKER_BUILD_HTTPS_PROXY=
DOCKER_BUILD_ALL_PROXY=
DOCKER_BUILD_NO_PROXY=localhost,127.0.0.1
# Optional proxy used by running containers. Docker Desktop users should use
# host.docker.internal instead of 127.0.0.1 for a proxy running on the host.
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_ALL_PROXY=
CONTAINER_NO_PROXY=localhost,127.0.0.1,db,weave
WEAVE_API_BIND_ADDRESS=127.0.0.1
WEAVE_API_PORT=8080
JWT_SECRET=
WEAVE_ADMIN_USER=admin
WEAVE_ADMIN_PASS=
POSTGRES_PASSWORD=weave

# Optional engines/providers; configure only those you use.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODELS=gpt-5.2,gpt-5.3-codex,gpt-5.4

# Optional operator protocol diagnostics, disabled by default. Set one exact
# workspace/workflow and optionally a parent run in private deployment config.
# EXPIRES_AT must be an explicit RFC3339 deadline within the next 24 hours;
# an expired policy remains inert on restart. Remove the private scope afterward.
# MAX_MODEL_CALLS is 1..64 reserved original model-journal perform attempts across
# nodes/restarts, including failed attempts; journal replay does not reserve again.
# Each reservation records at most 4 physical provider observations and 16 tool
# indexes per observation, with 4096-frame/delta bounds. Only counts and digests
# are recorded, never request bodies, headers, credentials or model reasoning.
# Missing, expired, exhausted or incomplete collection must not mean zero calls.
WEAVE_TOOL_PROTOCOL_PROBE_ENABLED=false
WEAVE_TOOL_PROTOCOL_PROBE_WORKSPACE_ID=
WEAVE_TOOL_PROTOCOL_PROBE_WORKFLOW_ID=
WEAVE_TOOL_PROTOCOL_PROBE_RUN_ID=
WEAVE_TOOL_PROTOCOL_PROBE_EXPIRES_AT=
WEAVE_TOOL_PROTOCOL_PROBE_MAX_MODEL_CALLS=

# 凭据加密主密钥：用于加密存储模型供应商 API Key、Embedder Key、MCP 服务器密钥、
# 交付目标密钥。服务端缺少有效主密钥时会拒绝启动。
# 生成示例：openssl rand -base64 32
# 警告：设置后不要更换或丢失——换 key 后已加密的凭据全部无法解密。
WEAVE_SECRET_KEY=
# 文件部署可改设 WEAVE_SECRET_KEY_FILE，并保持 WEAVE_SECRET_KEY 为空。
WEAVE_SECRET_KEY_FILE=

# Optional remote runtime, after registering it through runtime maintenance.
WEAVE_RUNTIME_TOKEN=

# Owner-bound key returned by `weave bootstrap`.
WEAVE_API_KEY=
# Public Weave URL advertised in new runtime connection commands. Leave blank for bare-host LAN discovery.
WEAVE_RUNTIME_SERVER_URL=
WEAVE_PLATFORM_IMAGE=weave-platform
