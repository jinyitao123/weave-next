DEEPSEEK_API_KEY=sk-your-deepseek-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
OPENAI_MODELS=gpt-5.2,gpt-5.3-codex,gpt-5.4

# 凭据加密主密钥：用于加密存储模型供应商 API Key、Embedder Key、MCP 服务器密钥、
# 交付目标密钥。不设置则 /v1/providers、/v1/embedder 返回 500，
# /v1/mcp-servers、/v1/delivery-targets 返回 503。
# 生成示例：openssl rand -base64 32
# 警告：设置后不要更换或丢失——换 key 后已加密的凭据全部无法解密。
WEAVE_SECRET_KEY=
