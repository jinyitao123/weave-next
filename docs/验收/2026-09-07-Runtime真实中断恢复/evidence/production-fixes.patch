diff --git a/internal/kernel/engine/proc_unix.go b/internal/kernel/engine/proc_unix.go
index 2885a4b..31262d2 100644
--- a/internal/kernel/engine/proc_unix.go
+++ b/internal/kernel/engine/proc_unix.go
@@ -3,10 +3,23 @@
 package engine
 
 import (
+	"errors"
+	"fmt"
 	"os/exec"
 	"syscall"
 )
 
+func processTerminationReason(waitErr error) string {
+	var exitErr *exec.ExitError
+	if !errors.As(waitErr, &exitErr) || exitErr.ProcessState == nil {
+		return ""
+	}
+	if state, ok := exitErr.Sys().(syscall.WaitStatus); ok && state.Signaled() {
+		return fmt.Sprintf("runtime_process_interrupted: signal %s", state.Signal())
+	}
+	return ""
+}
+
 func applyProcAttr(cmd *exec.Cmd) {
 	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}
 }
