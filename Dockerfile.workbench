# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24-bookworm
ARG WEAVE_IMAGE=weave-platform:latest

FROM ${NODE_IMAGE} AS build
RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential git musl-tools python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global pnpm@11.7.0
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --dir native/landlock-run build:native
ARG DSH_CLIENT_COMMIT_HASH
ARG DSH_CLIENT_VERSION=0.1.2-alpha.1
RUN test -n "$DSH_CLIENT_COMMIT_HASH" \
  && DSH_CLIENT_COMMIT_HASH="$DSH_CLIENT_COMMIT_HASH" \
     DSH_CLIENT_VERSION="$DSH_CLIENT_VERSION" \
     pnpm run build:workbench

FROM ${WEAVE_IMAGE} AS weave-runtime

FROM ${NODE_IMAGE} AS runtime
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git ripgrep \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global pnpm@11.7.0
WORKDIR /app
COPY --from=build /app /app
COPY --from=weave-runtime /usr/local/bin/weave /usr/local/bin/weave
ENV NODE_ENV=production
ENV DSH_HOME=/data/dsh
EXPOSE 3080
ENTRYPOINT ["node", "/app/apps/cli/lib/bin.js", "--profile", "workbench"]
CMD ["--host", "0.0.0.0", "--port", "3080", "--no-open"]
